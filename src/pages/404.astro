---
import Base from '../layouts/Base.astro'
---

<Base title="404 — Not found">
  <main
    id="main"
    class="mx-auto flex min-h-dvh max-w-2xl flex-col items-center justify-center px-5 text-center"
  >
    <p class="text-6xl font-bold text-accent">404</p>
    <h1 class="mt-4 text-xl font-semibold text-text">This page took a wrong turn.</h1>
    <p class="mt-3 text-muted">The link is broken or the page moved.</p>
    <a
      href="/"
      class="mt-8 rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-black transition-transform hover:-translate-y-0.5"
      >Back home</a
    >
  </main>
</Base>
