---
import Base from '../layouts/Base.astro'
import { site } from '../data/site'
import { experience, education, awards, languages } from '../data/experience'
import { skillGroups } from '../data/skills'

const summary =
  'Full stack developer with hands-on QA and IT-infrastructure experience. I build web apps end to end (React, Node.js, PostgreSQL) and write Python automations that remove manual work. Currently a Software Engineering student, open to junior / early-career roles.'
---

<Base title={`CV — ${site.name}`} description={`Résumé of ${site.name}, ${site.role}.`}>
  <main id="main" class="mx-auto max-w-3xl px-5 py-16 print:py-0">
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-3">
      <a href="/" class="text-sm text-muted hover:text-text">← Back to portfolio</a>
      <button
        id="print-btn"
        type="button"
        class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-black transition-transform hover:-translate-y-0.5"
        >Print / save as PDF</button
      >
    </div>

    <!-- header -->
    <header class="border-b border-border pb-6">
      <h1 class="text-3xl font-bold text-text">{site.name}</h1>
      <p class="mt-1 text-accent">{site.role}</p>
      <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
        <span>{site.location}</span>
        <a class="hover:text-text" href={`mailto:${site.email}`}>{site.email}</a>
        {
          site.socials.map((s) => (
            <a class="hover:text-text" href={s.href}>
              {s.href.replace('https://', '').replace('www.', '')}
            </a>
          ))
        }
      </p>
    </header>

    <!-- summary -->
    <section class="mt-6">
      <p class="text-sm leading-relaxed text-muted">{summary}</p>
    </section>

    <!-- experience -->
    <section class="mt-8">
      <h2 class="text-xs font-semibold tracking-widest text-accent uppercase">Experience</h2>
      <div class="mt-4 space-y-5">
        {
          experience.map((job) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="font-semibold text-text">
                  {job.role} <span class="font-normal text-muted">· {job.org}</span>
                </h3>
                <span class="text-sm text-muted">{job.period}</span>
              </div>
              <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm text-muted">
                {job.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- skills -->
    <section class="mt-8">
      <h2 class="text-xs font-semibold tracking-widest text-accent uppercase">Skills</h2>
      <dl class="mt-4 space-y-2 text-sm">
        {
          skillGroups.map((g) => (
            <div class="sm:flex sm:gap-3">
              <dt class="w-40 shrink-0 font-medium text-text">{g.label}</dt>
              <dd class="text-muted">{g.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- education -->
    <section class="mt-8">
      <h2 class="text-xs font-semibold tracking-widest text-accent uppercase">Education</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          education.map((e) => (
            <li class="flex flex-wrap justify-between gap-x-3">
              <span class="text-text">
                {e.title} <span class="text-muted">· {e.org}</span>
              </span>
              <span class="text-muted">{e.period}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- awards + languages -->
    <section class="mt-8 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-xs font-semibold tracking-widest text-accent uppercase">Awards</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            awards.map((a) => (
              <li class="text-muted">
                <span class="text-text">{a.title}</span> · {a.period}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-xs font-semibold tracking-widest text-accent uppercase">Languages</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            languages.map((l) => (
              <li class="text-muted">
                <span class="text-text">{l.name}</span> — {l.level}
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <script>
    document.getElementById('print-btn')?.addEventListener('click', () => window.print())
  </script>
</Base>
