---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import ProjectCard from '../components/ProjectCard.astro'
import andrei from '../assets/andrei.jpg'
import { site } from '../data/site'
import { projects } from '../data/projects'
import { skillGroups } from '../data/skills'
import { experience, education, awards, languages } from '../data/experience'

const wrap = 'mx-auto w-full max-w-6xl px-6'
---

<Base>
  <Header />

  <main id="main">
    <!-- Hero -->
    <section id="top" class="relative flex min-h-dvh items-center overflow-hidden">
      <div class="hero-glow"></div>
      <div class={`${wrap} relative grid items-center gap-14 py-28 lg:grid-cols-[1.35fr_1fr]`}>
        <div>
          <p data-rise class="eyebrow">
            <span class="sr-only">Role: </span>{site.role}
          </p>
          <h1
            data-rise
            class="mt-6 text-[2.6rem] font-extrabold leading-[1.05] tracking-tight text-text sm:text-6xl lg:text-7xl"
          >
            {site.name}
          </h1>
          <p data-rise-2 class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
            {site.tagline}
          </p>
          <div data-rise-3 class="mt-9 flex flex-wrap gap-3">
            <a
              href="#projects"
              class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-black transition-transform hover:-translate-y-0.5"
              >View projects</a
            >
            <a
              href="/cv"
              class="rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-text transition-colors hover:border-accent hover:text-accent"
              >Read CV</a
            >
            {
              site.socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-text transition-colors hover:border-accent hover:text-accent"
                >
                  {s.label} ↗
                </a>
              ))
            }
          </div>
        </div>

        <!-- info panel -->
        <aside
          data-rise-4
          class="rounded-2xl border border-border bg-surface/60 p-6 backdrop-blur-sm lg:p-7"
        >
          <p class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Open to {site.openTo}
          </p>
          <dl class="mt-6 space-y-4 text-sm">
            <div>
              <dt class="text-muted">Based in</dt>
              <dd class="mt-0.5 text-text">{site.location}</dd>
            </div>
            <div>
              <dt class="text-muted">Currently building</dt>
              <dd class="mt-0.5">
                <a href="#projects" class="text-accent hover:underline">Eventos Região</a>
                <span class="text-muted"> — a regional events platform</span>
              </dd>
            </div>
            <div>
              <dt class="text-muted">Going deeper into</dt>
              <dd class="mt-0.5 text-text">{site.focus}</dd>
            </div>
          </dl>
          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-sm">
            <a href={`mailto:${site.email}`} class="text-text hover:text-accent">Email</a>
            {
              site.socials.map((s) => (
                <a href={s.href} target="_blank" rel="noopener" class="text-text hover:text-accent">
                  {s.label}
                </a>
              ))
            }
          </div>
        </aside>
      </div>

      <a
        href="#about"
        class="absolute inset-x-0 bottom-6 mx-auto w-fit text-xs text-muted transition-colors hover:text-text"
        aria-label="Scroll to about"
      >
        ↓ scroll
      </a>
    </section>

    <!-- About -->
    <section id="about" class="border-t border-border bg-surface/40">
      <div class={`${wrap} py-16 lg:py-24`}>
        <h2 class="eyebrow">About</h2>
        <div class="mt-10 grid gap-10 md:grid-cols-[220px_1fr] md:items-start lg:gap-16">
          <Image
            data-reveal
            src={andrei}
            alt={`Portrait of ${site.name}`}
            width={440}
            height={440}
            class="h-44 w-44 rounded-2xl border border-border object-cover md:h-52 md:w-52"
          />
          <div data-reveal class="max-w-2xl space-y-4 text-base leading-relaxed text-muted">
            <p>
              I'm a full stack developer from {site.location.replace(' — ', ', ')}. I've worked
              across the whole lifecycle — <strong class="text-text">QA testing</strong> Java web
              apps, keeping systems and automations running as an
              <strong class="text-text">IT infrastructure analyst</strong>, and building web
              platforms end to end with React, Node.js and PostgreSQL.
            </p>
            <p>
              I care about software that is fast, accessible and actually gets used, so I sweat the
              details most people skip: tests, error and empty states, keyboard navigation,
              reduced-motion. Right now I'm going deeper into software architecture and automated
              testing, and I'm open to {site.openTo}.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="border-t border-border">
      <div class={`${wrap} py-16 lg:py-24`}>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="eyebrow">Selected projects</h2>
          <a
            href="https://github.com/AndreiVDS"
            target="_blank"
            rel="noopener"
            class="text-sm text-muted hover:text-accent">All repositories ↗</a
          >
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="border-t border-border bg-surface/40">
      <div class={`${wrap} py-16 lg:py-24`}>
        <h2 class="eyebrow">Skills</h2>
        <div class="mt-10 grid gap-10 md:grid-cols-3">
          {
            skillGroups.map((g) => (
              <div data-reveal>
                <h3 class="mb-4 text-sm font-semibold text-text">{g.label}</h3>
                <ul class="flex flex-wrap gap-2">
                  {g.items.map((s) => (
                    <li class="rounded-md border border-border bg-bg px-2.5 py-1 text-xs text-muted">
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="border-t border-border">
      <div class={`${wrap} py-16 lg:py-24`}>
        <h2 class="eyebrow">Experience</h2>
        <div class="mt-10 space-y-10">
          {
            experience.map((job) => (
              <div data-reveal class="grid gap-2 md:grid-cols-[190px_1fr] md:gap-8">
                <p class="text-sm text-muted">{job.period}</p>
                <div>
                  <h3 class="text-base font-semibold text-text">
                    {job.role} <span class="font-normal text-muted">· {job.org}</span>
                  </h3>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted">
                    {job.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-16 grid gap-12 border-t border-border pt-12 md:grid-cols-2">
          <div data-reveal>
            <h3 class="eyebrow">Education</h3>
            <ul class="mt-6 space-y-4 text-sm">
              {
                education.map((e) => (
                  <li>
                    <span class="text-text">{e.title}</span>
                    <br />
                    <span class="text-muted">
                      {e.org} · {e.period}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div data-reveal>
            <h3 class="eyebrow">Awards &amp; languages</h3>
            <ul class="mt-6 space-y-4 text-sm">
              {
                awards.map((a) => (
                  <li>
                    <span class="text-text">{a.title}</span>
                    <span class="text-muted"> · {a.period}</span>
                  </li>
                ))
              }
              {
                languages.map((l) => (
                  <li>
                    <span class="text-text">{l.name}</span>
                    <span class="text-muted"> — {l.level}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t border-border bg-surface/40">
      <div class={`${wrap} py-20 text-center lg:py-28`}>
        <div class="flex justify-center"><h2 class="eyebrow">Contact</h2></div>
        <p data-reveal class="mx-auto mt-8 max-w-2xl text-xl text-text sm:text-2xl">
          Open to {site.openTo}. The fastest way to reach me:
        </p>
        <div data-reveal class="mt-10 flex flex-wrap justify-center gap-3">
          <a
            href={`mailto:${site.email}`}
            class="rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-black transition-transform hover:-translate-y-0.5"
            >Email me</a
          >
          {
            site.socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="rounded-lg border border-border px-6 py-3 text-sm font-semibold text-text transition-colors hover:border-accent hover:text-accent"
              >
                {s.label} ↗
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-border">
    <div class={`${wrap} flex flex-wrap items-center justify-between gap-3 py-8 text-sm text-muted`}>
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>
        Built with Astro &amp; Tailwind ·{' '}
        <a
          href="https://github.com/AndreiVDS/Portifolio-andrei-vinicius"
          class="hover:text-text">source</a
        >
      </span>
    </div>
  </footer>
</Base>
