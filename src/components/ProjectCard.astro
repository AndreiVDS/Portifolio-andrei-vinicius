---
import { Image } from 'astro:assets'
import type { Project } from '../data/projects'

interface Props {
  project: Project
}
const { project } = Astro.props
---

<article
  data-reveal
  class:list={[
    'group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_16px_40px_-16px_rgba(0,0,0,0.5)]',
    project.featured && 'md:col-span-2 md:flex-row',
  ]}
>
  {
    project.image && (
      <div class:list={['overflow-hidden bg-surface-2', project.featured ? 'md:w-1/2' : '']}>
        <Image
          src={project.image}
          alt={`Screenshot of ${project.title}`}
          width={900}
          height={340}
          class="h-52 w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04] md:h-full"
          loading="lazy"
        />
      </div>
    )
  }

  <div class:list={['flex flex-1 flex-col gap-3 p-6', project.featured && 'md:w-1/2 md:p-8']}>
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-lg font-semibold text-text">{project.title}</h3>
      {
        project.featured && (
          <span class="rounded bg-accent-soft px-1.5 py-0.5 text-[11px] font-medium text-accent">
            Featured
          </span>
        )
      }
    </div>

    <p class="text-sm leading-relaxed text-muted">{project.blurb}</p>

    <ul class="mt-1 flex flex-wrap gap-1.5">
      {
        project.stack.map((t) => (
          <li class="rounded border border-border px-2 py-0.5 text-[11px] text-muted">{t}</li>
        ))
      }
    </ul>

    <div class="mt-auto flex flex-wrap gap-4 pt-3 text-sm">
      {
        project.caseStudy && (
          <a href={project.caseStudy} class="font-medium text-accent hover:underline">
            Read case study →
          </a>
        )
      }
      {
        project.live && (
          <a href={project.live} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">
            Live demo ↗
          </a>
        )
      }
      {
        project.repo && (
          <a href={project.repo} target="_blank" rel="noopener" class="text-muted hover:text-text">
            Code ↗
          </a>
        )
      }
    </div>
  </div>
</article>
