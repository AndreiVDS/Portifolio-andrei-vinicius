---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
]
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label="Primary">
    <a href="#top" class="font-bold tracking-tight text-text">Andrei&nbsp;V.</a>

    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {
        links.map((l) => (
          <li>
            <a
              class="nav-link relative py-1 transition-colors hover:text-text"
              href={l.href}
              data-nav={l.href.slice(1)}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md border border-border p-2 text-muted transition-colors hover:border-accent hover:text-accent"
        aria-label="Toggle colour theme"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>

      <a
        href="/cv"
        class="hidden rounded-md border border-border px-3 py-1.5 text-sm text-text transition-colors hover:border-accent hover:text-accent md:block"
        >CV</a
      >

      <button
        id="menu-toggle"
        type="button"
        class="rounded-md border border-border p-2 text-text md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="border-t border-border bg-bg px-6 py-4 md:hidden">
    <ul class="flex flex-col gap-4 text-base text-muted">
      {
        links.map((l) => (
          <li>
            <a class="block transition-colors hover:text-text" href={l.href} data-close>
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a class="block text-text" href="/cv" data-close>CV</a></li>
    </ul>
  </div>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    width: 100%;
    background: var(--color-accent);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-current='true']::after {
    transform: scaleX(1);
  }
  .nav-link[aria-current='true'] {
    color: var(--color-text);
  }
</style>

<script>
  const header = document.getElementById('site-header')
  const onScroll = () => {
    if (!header) return
    const on = window.scrollY > 8
    header.classList.toggle('bg-bg/80', on)
    header.classList.toggle('backdrop-blur', on)
    header.classList.toggle('border-border', on)
  }
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  // mobile menu
  const menuBtn = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  const setMenu = (open: boolean) => {
    if (!menu || !menuBtn) return
    menu.hidden = !open
    menuBtn.setAttribute('aria-expanded', String(open))
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
  }
  menuBtn?.addEventListener('click', () => setMenu(menu?.hidden ?? true))
  menu?.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', () => setMenu(false)))

  // theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement
    const next = root.classList.contains('dark') ? 'light' : 'dark'
    root.classList.toggle('dark', next === 'dark')
    try {
      localStorage.setItem('theme', next)
    } catch {}
  })

  // scrollspy: highlight the nav link for the section in view
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'))
  const sections = navLinks
    .map((l) => document.getElementById(l.dataset.nav || ''))
    .filter((s): s is HTMLElement => !!s)
  if ('IntersectionObserver' in window && sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            navLinks.forEach((l) =>
              l.setAttribute('aria-current', String(l.dataset.nav === e.target.id)),
            )
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    )
    sections.forEach((s) => spy.observe(s))
  }
</script>
